#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { 
            bindings = <
                &kp A  &kp B  &kp C  &kp A  &kp B  &kp C                         &kp A  &kp B  &kp C  &kp A  &kp B  &kp C
                &kp D  &kp E  &kp F  &kp D  &kp E  &kp F                         &kp D  &kp E  &kp F  &kp D  &kp E  &kp F
                &kp D  &kp E  &kp F  &kp D  &kp E  &kp F                         &kp D  &kp E  &kp F  &kp D  &kp E  &kp F
                              &kp F  &kp D                                                     &kp F  &kp D  
                                            &mo 1 &kp F                         &kp D  &kp E
                                                          &kp E  &kp F    &kp D  &kp E
                                                          &kp E  &kp F    &kp D  &kp E
            >;
        };
        
        raise { 
            bindings = <
                &bt BT_CLR  &bt BT_SEL 0   &bt BT_SEL 1    &trans   &trans   &trans                          &trans   &trans   &trans   &trans   &trans   &trans 
                &trans   &trans   &trans   &trans   &trans   &trans                          &trans   &trans   &trans   &trans   &trans   &trans 
                &trans   &trans   &trans   &trans   &trans   &trans                          &trans   &trans   &trans   &trans   &trans   &trans 
                              &trans   &trans                                                      &trans   &trans   
                                            &trans   &trans                          &trans   &trans 
                                                          &trans   &trans     &trans   &trans 
                                                          &trans   &trans     &trans   &trans 
            >;
        };
    };
 };